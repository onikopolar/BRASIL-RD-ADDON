# Real-Debrid
TORBOX_API_KEY=SUA-API-AQUI

# Aplicação
NODE_ENV=development
PORT=7000

# Database Configuração
# Desenvolvimento local (tirar o coment quando for testar local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brasil_rd_addon?sslmode=disable

# Produção Railway (descomenta se for fazer deploy)
# DATABASE_URL="postgresql://postgres:postgres@crossover.proxy.rlwy.net:24177/railway"

# SSL pra conexão externa
DB_SSL=true

# SSL local (HTTPS no localhost)
SSL_PRIVATE_KEY=localhost.key
SSL_CERTIFICATE=localhost.crt

# TMDB Configuração irada
TMDB_API_KEY=4bfe2bbccad24f1bb07507953a137ebd

# Logging Pra saber as bosta
LOG_LEVEL=debug

# Cache Configuração
CACHE_TTL=86400

# Cloudflare Tunnel (token permanente do túnel)
CLOUDFLARED_TOKEN=eyJhIjoiZTBiMjMzZDI0ZjI4MjI2OWI0MDYxZTYwM2RiY2UwNmIiLCJ0IjoiZjNlMDdlNTEtM2ExMi00ZDZjLTkwNjYtZjhmZDQ1MzZkMjZmIiwicyI6IlltUXlNMlF4WWpndE5USTNPUzAwTkRkbUxUazJNV0V0TUdFeVlXWXpPR0U0WkRjMiJ9

# Proxy para sites bloqueados no roteador (Comando, etc)
# Formatos aceitos: http://host:port, socks5://host:port
# Ex: VPN local expoe proxy em localhost:8118 (Privoxy) ou localhost:1080 (SOCKS5)
# PROXY_URL=http://localhost:8118

# API Key do curador — usada para ativar AirLock em torrents 1080p ou inferior
# Torrents 4K/2160p NÃO recebem AirLock (economia de espaço)
TORBOX_CURATOR_API_KEY=4bfe2bbccad24f1bb07507953a137ebd

# URL base pública do addon (usada para gerar URLs absolutas nos streams)
BASE_URL=https://brasil-rd-oficial.oniko.org